# RAG Model Configuration

# Optional: Add OpenAI API key for GPT-4o / GPT-4o-mini generation
OPENAI_API_KEY=

# Optional: Add Anthropic API key for Claude generation
ANTHROPIC_API_KEY=

# Provider: 'auto', 'openai', 'anthropic', 'ollama', or 'offline'
# In 'auto' mode: tries OpenAI → Anthropic → Ollama (local) → offline extractive
LLM_PROVIDER=auto

# Models
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama (local, no API key needed — install from https://ollama.com)
# Make sure Ollama is running: `ollama serve`
# Available models on this machine: qwen3:8b, qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# RAG Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K_CHUNKS=4

# Concurrency & Networking
HOST=0.0.0.0
PORT=8000
MAX_CONCURRENT_USERS=50
