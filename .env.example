# RAG Model Configuration

# Optional: Add OpenAI API key for GPT-4o / GPT-4o-mini generation
OPENAI_API_KEY=

# Optional: Add Anthropic API key for Claude generation
ANTHROPIC_API_KEY=

# Provider: 'auto', 'openai', 'anthropic', or 'offline' (runs without internet / API key)
LLM_PROVIDER=auto

# Models
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# RAG Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K_CHUNKS=4

# Concurrency & Networking
HOST=0.0.0.0
PORT=8000
MAX_CONCURRENT_USERS=50
